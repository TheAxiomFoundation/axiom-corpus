      <Explicatus>§ 1</Explicatus>
      <Exitus><Linea><Char>I lov om folkeskolen, jf. lovbekendtgørelse nr. 989 af 27. august 2024, foretages følgende ændring:</Char></Linea></Exitus>
      <AendringsNummer>
        <Explicatus>1.</Explicatus>
        <Aendring>
          <AendringDefinition><Exitus><Linea><Char>Efter § 54 indsættes:</Char></Linea></Exitus></AendringDefinition>
          <AendringAktion><AendringNyTekst>
          <Paragraf id="idf1926251-f39e-421d-a808-e8cdd22eb407" localId="54a">
            <Explicatus>§ 54 a.</Explicatus>
            <Stk><Exitus><Linea><Char>Personer under 18 år må ikke anvendes som tolke ved mundtlig kommunikation, jf. dog stk. 2.</Char></Linea></Exitus></Stk>
            <Stk><Explicatus>Stk. 2.</Explicatus><Exitus><Linea><Char>Personer under 18 år må anvendes som tolke uanset stk. 1, når kommunikationen vedrører et uproblematisk forhold.</Char></Linea></Exitus></Stk>
          </Paragraf>
          </AendringNyTekst></AendringAktion>
        </Aendring>
