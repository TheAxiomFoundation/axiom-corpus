            "scopes": [
                {
                    "document_class": "regulation",
                    "jurisdiction": "nz",
                    "version": VERSION,
                },
                {
                    "document_class": "statute",
                    "jurisdiction": "nz",
                    "version": VERSION,
                },
            ],
        }
