  "Html": "<div><html>\r\n\r\n<head>\r\n<title>Rule 67:10:06:06 Work activities -- Level of participation.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:06:06\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:06:06 Work activities -- Level of participation.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:10.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\nh1\r\n\t{mso-style-link:\"Heading 1 Char\";\r\n\tmargin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:center;\r\n\tpage-break-after:avoid;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";\r\n\tfont-weight:normal;\r\n\ttext-decoration:underline;}\r\np.MsoBodyText2, li.MsoBodyText2, div.MsoBodyText2\r\n\t{mso-style-link:\"Body Text 2 Char\";\r\n\tmargin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\nspan.Heading1Char\r\n\t{mso-style-name:\"Heading 1 Char\";\r\n\tmso-style-link:\"Heading 1\";\r\n\tfont-family:\"Times New Roman\",\"serif\";\r\n\ttext-decoration:underline;}\r\nspan.BodyText2Char\r\n\t{mso-style-name:\"Body Text 2 Char\";\r\n\tmso-style-link:\"Body Text 2\";\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span\r\nstyle='font-weight:bold'>67:10:06:06.&nbsp;&nbsp;Work activities -- Level of\r\nparticipation.</span></b> The minimum level of participation for required work\r\nactivities is as follows:</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0\r\n style='margin-left:72.9pt;border-collapse:collapse;border:none'>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-bottom:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <h1 style='text-align:justify'><b><font size=3 face=\"Times New Roman\"><span\r\n  style='font-size:12.0pt;font-weight:bold;text-decoration:none'>TYPE OF\r\n  HOUSEHOLD</span></font></b></h1>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:solid windowtext 1.0pt;\r\n  border-left:none;border-bottom:none;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <h1 style='text-align:justify'><b><font size=3 face=\"Times New Roman\"><span\r\n  style='font-size:12.0pt;font-weight:bold;text-decoration:none'>WORK\r\n  REQUIREMENT</span></font></b></h1>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal style='text-align:justify'><font size=2\r\n  face=\"Times New Roman\"><span style='font-size:10.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal style='text-align:justify'><font size=2\r\n  face=\"Times New Roman\"><span style='font-size:10.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal style='text-align:justify'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>One-parent household\r\n  that has a child under the age of six</span></font></p>\r\n  <p class=MsoNormal style='text-align:justify'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>20 hours a week</span></font></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoBodyText2><font size=3 face=\"Times New Roman\"><span\r\n  style='font-size:12.0pt'>One-parent household that has a child or children\r\n  over the age of six</span></font></p>\r\n  <p class=MsoNormal style='text-align:justify'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>30 hours a week</span></font></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoBodyText2><font size=3 face=\"Times New Roman\"><span\r\n  style='font-size:12.0pt'>Two-parent household that does not receive financial\r\n  assistance for child care services under article 67:47</span></font></p>\r\n  <p class=MsoNormal style='text-align:justify'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>35 hours a week</span></font></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=264 valign=top style='width:2.75in;border:solid windowtext 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoBodyText2><font size=3 face=\"Times New Roman\"><span\r\n  style='font-size:12.0pt'>Two-parent household that receives financial\r\n  assistance for child care services under article 67:47</span></font></p>\r\n  <p class=MsoNormal style='text-align:justify'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n  </td>\r\n  <td width=204 valign=top style='width:153.0pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><font size=3\r\n  face=\"Times New Roman\"><span style='font-size:12.0pt'>55 hours a week</span></font></p>\r\n  </td>\r\n </tr>\r\n</table>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; A two-parent\r\nhousehold that includes a parent who is exempt from participating in work\r\nactivities under subdivision 67:10:06:07(3) or (4) is considered to be a\r\none-parent household when determining the number of work hours required under\r\nthis section.</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; When\r\ndetermining whether a two-parent household has met its required level of\r\nparticipation, the department shall combine the hours worked by each parent.</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span\r\nstyle='font-weight:bold'>Source:</span></b> 24 SDR 24, effective August 31,\r\n1997; 24 SDR 177, effective June 22, 1998; 25 SDR 157, effective June 1, 1999;\r\n26 SDR 18, effective August 18, 1999; 36 SDR 103, effective December 23, 2009.</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span\r\nstyle='font-weight:bold'>General Authority:</span></b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1)(2)(3)(4)</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-10\">28-7A-10</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-11\">28-7A-11.</A></span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span\r\nstyle='font-weight:bold'>Law Implemented:</span></b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1)(2)(3)(4)</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-10\">28-7A-10</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-11\">28-7A-11.</A></span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span\r\nstyle='font-weight:bold'>Cross-References:</span></b></span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Family with\r\ndisabled parent not treated as two-parent family, Pub. L. No. 105-33,\r\n&#167;&nbsp;5504(a)(C) (111 Stat.609) (August 5, 1997)</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Sharing of work\r\nrequirement in two-parent families, Pub. L. No. 105-33, &#167;&nbsp;5504(d) (111\r\nStat. 609) (August 5, 1997).</span></font></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><font size=3\r\nface=\"Times New Roman\"><span style='font-size:12.0pt'>&nbsp;</span></font></p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div>",
