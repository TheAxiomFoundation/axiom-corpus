  "Html": "<div><html>\r\n\r\n<head>\r\n<title>Rule 67:10:07:01 Definitions.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:07:01\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:07:01 Definitions.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>67:10:07:01.&nbsp;&nbsp;Definitions.</span></b> Terms used in this chapter mean:</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (1)&nbsp;&nbsp;&quot;Emergency payment,&quot; the payment\r\nmade by the department to another individual on behalf of the assistance unit\r\nwhen the relative acting as the payee is no longer available to receive the payment;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (2)&nbsp;&nbsp;&quot;Payee,&quot; the individual to whom the\r\npayment is made;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (3)&nbsp;&nbsp;&quot;Protective payee,&quot; the individual\r\nwho manages or supervises the expenditure of the assistance payment for the\r\nbenefit of the assistance unit;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (4)&nbsp;&nbsp;&quot;Protective payment,&quot; payment of the\r\nassistance unit's grant to another individual because of mismanagement;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (5)&nbsp;&nbsp;&quot;Two-party payment,&quot; a protective\r\npayment that is payable to the caretaker relative and the vendor; and</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (6)&nbsp;&nbsp;&quot;Vendor payment,&quot; a protective\r\npayment that is for expenses incurred by the assistance unit and is made\r\npayable only to the vendor.</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>Source:</span></b> 24 SDR\r\n24, effective August 31, 1997; 39 SDR 220, effective June 27, 2013.</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>General Authority:</span></b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(7).</A></span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>Law Implemented:</span></b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(7).</A></span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div>",
