  "Html": "<div><html>\r\n\r\n<head>\r\n<title>Rule 67:10:06:12 Work activities -- Job search and job readiness.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:06:12\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:06:12 Work activities -- Job search and job readiness.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>67:10:06:12.&nbsp;&nbsp;Work\r\nactivities -- Job search and job readiness.</span></b> An individual in job\r\nsearch must complete the following activities:</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (1)&nbsp;&nbsp;Register for work with the Department of Labor\r\nand Regulation;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (2)&nbsp;&nbsp;Apply for unemployment insurance benefits, if\r\neligible;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (3)&nbsp;&nbsp;Attend the training and workshops specified in\r\nthe individual's personal responsibility plan; and</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (4)&nbsp;&nbsp;Make employer contacts.</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>Source:</span></b> 24 SDR\r\n24, effective August 31, 1997; 24 SDR 177, effective June 22, 1998; 36 SDR 103,\r\neffective December 21, 2009; 39 SDR 220, effective June 27, 2013.</span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>General Authority:</span></b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1)(2)(3)(4)</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-10\">28-7A-10.</A></span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b><span style='font-weight:bold'>Law Implemented:</span></b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1)(2)(3)(4)</A>, <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-10\">28-7A-10.</A></span></font></p>\r\n\r\n<p class=MsoNormal><font size=3 face=\"Times New Roman\"><span style='font-size:\r\n12.0pt'>&nbsp;</span></font></p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div>",
