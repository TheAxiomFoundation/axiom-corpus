  "Html": "<div><html xmlns:o=\"urn:schemas-microsoft-com:office:office\"\r\nxmlns:w=\"urn:schemas-microsoft-com:office:word\"\r\nxmlns=\"http://www.w3.org/TR/REC-html40\">\r\n\r\n<head>\r\n<title>Rule 67:10:04:20 Determining periods of ineligibility.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:04:20\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:04:20 Determining periods of ineligibility.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=ProgId content=Word.Document>\r\n<meta name=Generator content=\"Microsoft Word 10\">\r\n<meta name=Originator content=\"Microsoft Word 10\">\r\n<link rel=File-List href=\"6710040002000d_files/filelist.xml\">\r\n<!--[if gte mso 9]><xml>\r\n <o:DocumentProperties>\r\n  <o:Author>lrpr14533</o:Author>\r\n  <o:LastAuthor>lrpr14296</o:LastAuthor>\r\n  <o:Revision>2</o:Revision>\r\n  <o:TotalTime>5</o:TotalTime>\r\n  <o:Created>2005-09-22T19:57:00Z</o:Created>\r\n  <o:LastSaved>2005-09-22T19:57:00Z</o:LastSaved>\r\n  <o:Pages>1</o:Pages>\r\n  <o:Words>130</o:Words>\r\n  <o:Characters>747</o:Characters>\r\n  <o:Company>State of South Dakota</o:Company>\r\n  <o:Lines>6</o:Lines>\r\n  <o:Paragraphs>1</o:Paragraphs>\r\n  <o:CharactersWithSpaces>876</o:CharactersWithSpaces>\r\n  <o:Version>10.4219</o:Version>\r\n </o:DocumentProperties>\r\n</xml><![endif]--><!--[if gte mso 9]><xml>\r\n <w:WordDocument>\r\n  <w:GrammarState>Clean</w:GrammarState>\r\n  <w:Compatibility>\r\n   <w:BreakWrappedTables/>\r\n   <w:SnapToGridInCell/>\r\n   <w:WrapTextWithPunct/>\r\n   <w:UseAsianBreakRules/>\r\n  </w:Compatibility>\r\n  <w:BrowserLevel>MicrosoftInternetExplorer4</w:BrowserLevel>\r\n </w:WordDocument>\r\n</xml><![endif]-->\r\n<style>\r\n<!--\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{mso-style-parent:\"\";\r\n\tmargin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\tmso-pagination:widow-orphan;\r\n\tfont-size:10.0pt;\r\n\tfont-family:\"Times New Roman\";\r\n\tmso-fareast-font-family:\"Times New Roman\";}\r\nspan.GramE\r\n\t{mso-style-name:\"\";\r\n\tmso-gram-e:yes;}\r\n@page Section1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:49.7pt 1.0in 49.7pt 63.35pt;\r\n\tmso-header-margin:.5in;\r\n\tmso-footer-margin:.5in;\r\n\tmso-paper-source:0;}\r\ndiv.Section1\r\n\t{page:Section1;}\r\n-->\r\n</style>\r\n<!--[if gte mso 10]>\r\n<style>\r\n /* Style Definitions */\r\n table.MsoNormalTable\r\n\t{mso-style-name:\"Table Normal\";\r\n\tmso-tstyle-rowband-size:0;\r\n\tmso-tstyle-colband-size:0;\r\n\tmso-style-noshow:yes;\r\n\tmso-style-parent:\"\";\r\n\tmso-padding-alt:0in 5.4pt 0in 5.4pt;\r\n\tmso-para-margin:0in;\r\n\tmso-para-margin-bottom:.0001pt;\r\n\tmso-pagination:widow-orphan;\r\n\tfont-size:10.0pt;\r\n\tfont-family:\"Times New Roman\";}\r\n</style>\r\n<![endif]-->\r\n</head>\r\n\r\n<body lang=EN-US style='tab-interval:.5in'>\r\n\r\n<div class=Section1>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><b style='mso-bidi-font-weight:normal'>67:10:04:20.<span\r\nclass=GramE>&nbsp;&nbsp;Determining</span> periods of ineligibility.</b> The\r\nperiod of ineligibility for an assistance unit which transferred, assigned, or\r\nsold property for the purpose of establishing or maintaining eligibility is up\r\nto one year from the date the department discovers the transfer.<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>The period of ineligibility is based on the amount by which\r\nthe transferred, assigned, or sold resource, when added to other countable\r\nresources, exceeds the allowable resource limit. The following chart is used to\r\ncalculate the period of ineligibility:<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<div align=center>\r\n\r\n<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0\r\n style='margin-left:47.0pt;border-collapse:collapse;border:none;mso-border-alt:\r\n solid windowtext .5pt;mso-padding-alt:0in 5.4pt 0in 5.4pt;mso-border-insideh:\r\n .5pt solid windowtext;mso-border-insidev:.5pt solid windowtext'>\r\n <tr style='mso-yfti-irow:0;page-break-inside:avoid;height:24.5pt'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt;height:24.5pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b\r\n  style='mso-bidi-font-weight:normal'><span style='font-size:12.0pt;mso-bidi-font-size:\r\n  10.0pt'>AMOUNT BY WHICH RESOURCE LIMIT<o:p></o:p></span></b></p>\r\n  <p class=MsoNormal align=center style='text-align:center'><b\r\n  style='mso-bidi-font-weight:normal'><span style='font-size:12.0pt;mso-bidi-font-size:\r\n  10.0pt'>IS EXCEEDED<o:p></o:p></span></b></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border:solid windowtext 1.0pt;\r\n  border-left:none;mso-border-left-alt:solid windowtext .5pt;mso-border-alt:\r\n  solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt;height:24.5pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b\r\n  style='mso-bidi-font-weight:normal'><span style='font-size:12.0pt;mso-bidi-font-size:\r\n  10.0pt'>MONTH(S) OF<o:p></o:p></span></b></p>\r\n  <p class=MsoNormal align=center style='text-align:center'><b\r\n  style='mso-bidi-font-weight:normal'><span style='font-size:12.0pt;mso-bidi-font-size:\r\n  10.0pt'>INELIGIBILITY<o:p></o:p></span></b></p>\r\n  </td>\r\n </tr>\r\n <tr style='mso-yfti-irow:0'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  border-top:none;mso-border-top-alt:solid windowtext .5pt;mso-border-alt:solid windowtext .5pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>$<span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>0 up to $<span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>250.00<o:p></o:p></span></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  mso-border-top-alt:solid windowtext .5pt;mso-border-left-alt:solid windowtext .5pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>1<o:p></o:p></span></p>\r\n  </td>\r\n </tr>\r\n <tr style='mso-yfti-irow:0'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  border-top:none;mso-border-top-alt:solid windowtext .5pt;mso-border-alt:solid windowtext .5pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>250 up to<span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>1,000.00<o:p></o:p></span></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  mso-border-top-alt:solid windowtext .5pt;mso-border-left-alt:solid windowtext .5pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>3<o:p></o:p></span></p>\r\n  </td>\r\n </tr>\r\n <tr style='mso-yfti-irow:0'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  border-top:none;mso-border-top-alt:solid windowtext .5pt;mso-border-alt:solid windowtext .5pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>1,000 up to<span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>3,000.00<o:p></o:p></span></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  mso-border-top-alt:solid windowtext .5pt;mso-border-left-alt:solid windowtext .5pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>6<o:p></o:p></span></p>\r\n  </td>\r\n </tr>\r\n <tr style='mso-yfti-irow:0'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  border-top:none;mso-border-top-alt:solid windowtext .5pt;mso-border-alt:solid windowtext .5pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>3,000 up to<span\r\n  style='mso-spacerun:yes'>&nbsp;&nbsp; </span>5,000.00<o:p></o:p></span></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  mso-border-top-alt:solid windowtext .5pt;mso-border-left-alt:solid windowtext .5pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>9<o:p></o:p></span></p>\r\n  </td>\r\n </tr>\r\n <tr style='mso-yfti-irow:0;mso-yfti-lastrow:yes'>\r\n  <td width=348 valign=top style='width:261.05pt;border:solid windowtext 1.0pt;\r\n  border-top:none;mso-border-top-alt:solid windowtext .5pt;mso-border-alt:solid windowtext .5pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>5,000 or more<o:p></o:p></span></p>\r\n  </td>\r\n  <td width=144 valign=top style='width:107.7pt;border-top:none;border-left:\r\n  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;\r\n  mso-border-top-alt:solid windowtext .5pt;mso-border-left-alt:solid windowtext .5pt;\r\n  mso-border-alt:solid windowtext .5pt;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:12.0pt;mso-bidi-font-size:10.0pt'>12<o:p></o:p></span></p>\r\n  </td>\r\n </tr>\r\n</table>\r\n\r\n</div>\r\n\r\n<p class=MsoNormal align=center style='text-align:center;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.