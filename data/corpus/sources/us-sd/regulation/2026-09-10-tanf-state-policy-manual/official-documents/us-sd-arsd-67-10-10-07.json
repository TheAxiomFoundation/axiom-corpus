  "Html": "<div><html xmlns:v=\"urn:schemas-microsoft-com:vml\"\r\nxmlns:o=\"urn:schemas-microsoft-com:office:office\"\r\nxmlns:w=\"urn:schemas-microsoft-com:office:word\"\r\nxmlns=\"http://www.w3.org/TR/REC-html40\">\r\n\r\n<head>\r\n<title>Rule 67:10:10:07 Continuance of aid pending hearing decision.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:10:07\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:10:07 Continuance of aid pending hearing decision.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=ProgId content=Word.Document>\r\n<meta name=Generator content=\"Microsoft Word 10\">\r\n<meta name=Originator content=\"Microsoft Word 10\">\r\n<link rel=File-List href=\"6710100000700d_files/filelist.xml\">\r\n<!--[if gte mso 9]><xml>\r\n <o:DocumentProperties>\r\n  <o:Author>lrpr14533</o:Author>\r\n  <o:LastAuthor>lrpr14296</o:LastAuthor>\r\n  <o:Revision>2</o:Revision>\r\n  <o:TotalTime>0</o:TotalTime>\r\n  <o:Created>2009-12-22T21:37:00Z</o:Created>\r\n  <o:LastSaved>2009-12-22T21:37:00Z</o:LastSaved>\r\n  <o:Pages>1</o:Pages>\r\n  <o:Words>215</o:Words>\r\n  <o:Characters>1232</o:Characters>\r\n  <o:Company>State of South Dakota</o:Company>\r\n  <o:Lines>10</o:Lines>\r\n  <o:Paragraphs>2</o:Paragraphs>\r\n  <o:CharactersWithSpaces>1445</o:CharactersWithSpaces>\r\n  <o:Version>10.6856</o:Version>\r\n </o:DocumentProperties>\r\n</xml><![endif]--><!--[if gte mso 9]><xml>\r\n <w:WordDocument>\r\n  <w:PunctuationKerning/>\r\n  <w:Compatibility>\r\n   <w:BreakWrappedTables/>\r\n   <w:SnapToGridInCell/>\r\n   <w:WrapTextWithPunct/>\r\n   <w:UseAsianBreakRules/>\r\n  </w:Compatibility>\r\n  <w:BrowserLevel>MicrosoftInternetExplorer4</w:BrowserLevel>\r\n </w:WordDocument>\r\n</xml><![endif]-->\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;\r\n\tmso-font-charset:0;\r\n\tmso-generic-font-family:swiss;\r\n\tmso-font-pitch:variable;\r\n\tmso-font-signature:-1610611985 1073750139 0 0 159 0;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{mso-style-parent:\"\";\r\n\tmargin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\tmso-pagination:widow-orphan;\r\n\tfont-size:10.0pt;\r\n\tfont-family:\"Times New Roman\";\r\n\tmso-fareast-font-family:\"Times New Roman\";}\r\n@page Section1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;\r\n\tmso-header-margin:.5in;\r\n\tmso-footer-margin:.5in;\r\n\tmso-paper-source:0;}\r\ndiv.Section1\r\n\t{page:Section1;}\r\n-->\r\n</style>\r\n<!--[if gte mso 10]>\r\n<style>\r\n /* Style Definitions */\r\n table.MsoNormalTable\r\n\t{mso-style-name:\"Table Normal\";\r\n\tmso-tstyle-rowband-size:0;\r\n\tmso-tstyle-colband-size:0;\r\n\tmso-style-noshow:yes;\r\n\tmso-style-parent:\"\";\r\n\tmso-padding-alt:0in 5.4pt 0in 5.4pt;\r\n\tmso-para-margin:0in;\r\n\tmso-para-margin-bottom:.0001pt;\r\n\tmso-pagination:widow-orphan;\r\n\tfont-size:10.0pt;\r\n\tfont-family:\"Times New Roman\";}\r\n</style>\r\n<![endif]--><!--[if gte mso 9]><xml>\r\n <o:shapedefaults v:ext=\"edit\" spidmax=\"2050\"/>\r\n</xml><![endif]--><!--[if gte mso 9]><xml>\r\n <o:shapelayout v:ext=\"edit\">\r\n  <o:idmap v:ext=\"edit\" data=\"1\"/>\r\n </o:shapelayout></xml><![endif]-->\r\n</head>\r\n\r\n<body lang=EN-US style='tab-interval:.5in'>\r\n\r\n<div class=Section1>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><b style='mso-bidi-font-weight:normal'>67:10:10:07.&nbsp;&nbsp;Continuance\r\nof aid pending hearing decision.</b> If the recipient requests a fair hearing\r\nwithin ten days after the department mails the notice of adverse action, the\r\ndepartment shall continue to provide assistance without reducing, terminating,\r\nsuspending, or changing the manner or form of payment until the fair hearing\r\ndecision is made. The recipient may request that continued assistance not be\r\npaid during that time.<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>In no case may assistance be continued if any of the\r\nfollowing circumstances exist:<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>(1)&nbsp;&nbsp;The adverse action is due to a change which\r\naffects a majority of recipients and the only issue being contested is\r\neligibility, the benefit level, or whether state or federal law or policy was\r\nimproperly applied;<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>(2)&nbsp;&nbsp;The recipient fails to submit a completed\r\nreport form if one is required;<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>(3)&nbsp;&nbsp;The hearing examiner determines at the\r\nhearing that the sole issue is one of state or federal law or policy and not of\r\nan incorrect grant computation; or<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>(4)&nbsp;&nbsp;Pending the hearing decision, the recipient's\r\ncircumstances change in a way that affects the recipient's eligibility for or\r\namount of assistance.<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>Aid continued under this section is subject to recovery by\r\nthe department if, as a result of the fair hearing, the department's action is\r\nupheld.<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><b style='mso-bidi-font-weight:normal'>Source:</b> 24 SDR\r\n24, effective August 31, 1997; 36 SDR 103, effective December 21, 2009.<o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><b style='mso-bidi-font-weight:normal'>General Authority:</b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(12).</A><o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><span style='mso-tab-count:\r\n1'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><b style='mso-bidi-font-weight:normal'>Law Implemented:</b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(12).</A><o:p></o:p></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify;tab-stops:.4in .6in .9in 1.1in 1.4in 1.6in 1.9in 2.1in 2.4in 2.6in 2.9in 3.1in 3.4in 3.6in 3.9in 4.1in'><span\r\nstyle='font-size:12.0pt;mso-bidi-font-size:10.0pt'><o:p>&nbsp;</o:p></span></p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div>",
