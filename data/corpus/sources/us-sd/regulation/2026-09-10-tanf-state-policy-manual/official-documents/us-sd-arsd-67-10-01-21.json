  "Html": "<div><html>\r\n\r\n<head>\r\n<title>Rule 67:10:01:21 Date financial assistance begins.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:10:01:21\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:10:01:21 Date financial assistance begins.\">\r\n<meta name=Generator content=\"Microsoft Office HTML Filter 2.0\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Originator content=\"Microsoft Word 10\">\r\n<style>\r\n<!--\r\n \r\n-->\r\n</style>\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div>\r\n\r\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>67:10:01:21.&nbsp;&nbsp;Date financial assistance begins.</b> Financial\r\nassistance may not begin before the date of application.</p>\r\n\r\n\r\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Source:</b> 24 SDR\r\n24, effective August 31, 1997.</p>\r\n\r\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>General Authority:</b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1).</A></p>\r\n\r\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Law Implemented:</b>\r\nSDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-7A-3\">28-7A-3(1).</A></p>\r\n\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div>",
