  "Html": "<div><html>\r\n\r\n<head>\r\n<meta name=Generator content=\"Microsoft Office HTML Filter 2.0\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Originator content=\"Microsoft Word 10\">\r\n<title>Rule 67:46:13 TRANSITIONAL MEDICAL BENEFITS</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13 TRANSITIONAL MEDICAL BENEFITS\">\r\n<style>\r\n<!--\r\n \r\n-->\r\n</style>\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div>\r\n\r\n<p align=center><b>CHAPTER 67:46:13</b></p>\r\n\r\n<p align=center><b>&nbsp;</b></p>\r\n\r\n<p align=center><b>TRANSITIONAL MEDICAL BENEFITS</b></p>\r\n\r\n\r\n\r\n<p>Section</p>\r\n\r\n<p><a href=\"DisplayRule.aspx?Rule=67:46:13:01\">67:46:13:01</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Definitions.</p>\r\n\r\n<p><a href=\"DisplayRule.aspx?Rule=67:46:13:02\">67:46:13:02</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Initial eligibility\r\nfor transitional medical benefits.</p>\r\n\r\n<p><a href=\"DisplayRule.aspx?Rule=67:46:13:03\">67:46:13:03</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; TMB limited to 12\r\nconsecutive months.</p>\r\n\r\n<p><a href=\"DisplayRule.aspx?Rule=67:46:13:04\">67:46:13:04</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Continuing\r\neligibility for TMB.</p>\r\n\r\n<p>67:46:13:05\r\nto <a href=\"DisplayRule.aspx?Rule=67:46:13:10\">67:46:13:10</a>&nbsp;&nbsp;&nbsp; Repealed.</p>\r\n\r\n<p><a href=\"DisplayRule.aspx?Rule=67:46:13:11\">67:46:13:11</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Ineligibility for\r\nfraud.</p>\r\n\r\n\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div><br /><hr><br /><div><html>\r\n\r\n<head>\r\n<title>Rule 67:46:13:01 Definitions.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13:01\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13:01 Definitions.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>67:46:13:01.&nbsp;&nbsp;Definitions.</b> Terms\r\nused in this chapter mean:</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (1)&nbsp;&nbsp;&quot;Parent/caretaker\r\nrelative,&quot; a Medicaid coverage group consisting of low income families\r\neligible for Medicaid under the provisions of chapter 67:46:12; and</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (2)&nbsp;&nbsp;&quot;TMB&quot; or\r\n&quot;transitional medical benefits,&quot; continued medical coverage\r\nimmediately following ineligibility for parent/caretaker relative Medicaid.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Source:</b> 24 SDR 24, effective August 31,\r\n1997; 36 SDR 215, effective July 1, 2010; 41 SDR 7, effective July 29, 2014.</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>General Authority:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Law Implemented:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Cross-Reference:</b> Medicaid eligibility --\r\nParent/caretaker relative, &#167;&nbsp;67:46:12:02.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div><br /><hr><br /><div><html>\r\n\r\n<head>\r\n<title>Rule 67:46:13:02 Initial eligibility for transitional medical benefits.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13:02\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13:02 Initial eligibility for transitional medical benefits.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>67:46:13:02.&nbsp;&nbsp;Initial eligibility for\r\ntransitional medical benefits.</b> An individual that becomes ineligible for\r\nparent/caretaker relative Medicaid and any dependent child in the\r\nparent/caretaker relative's household is eligible for TMB if the following conditions\r\nexist:</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (1)&nbsp;&nbsp;The individual was receiving\r\nMedicaid under the provisions of chapter 67:46:12 in the immediately preceding\r\nmonth but became prospectively ineligible because the parent/caretaker relative\r\nhad increased income from employment; and</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; (2)&nbsp;&nbsp;The individual received Medicaid\r\nunder the provisions of chapter 67:46:12 in any 3 or more months during the\r\n6-month period immediately before the month in which the parent/caretaker\r\nrelative became ineligible.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Source:</b> 24 SDR 24, effective August 31, 1997;\r\n36 SDR 215, effective July 1, 2010; 41 SDR 7, effective July 29, 2014.</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>General Authority:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Law Implemented:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div><br /><hr><br /><div><html>\r\n\r\n<head>\r\n<title>Rule 67:46:13:03 TMB limited to 12 consecutive months.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13:03\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13:03 TMB limited to 12 consecutive months.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>67:46:13:03.&nbsp;&nbsp;TMB limited to 12\r\nconsecutive months.</b> Transitional medical benefits may begin the first month\r\nthe parent/caretaker relative is ineligible for Medicaid under the provisions\r\nof chapter 67:46:12 and is limited to the 12 consecutive months immediately\r\nfollowing ineligibility for Medicaid.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Source:</b> 24 SDR 24, effective August 31,\r\n1997; 36 SDR 215, effective July 1, 2010; 41 SDR 7, effective July 29, 2014.</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>General Authority:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Law Implemented:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div><br /><hr><br /><div><html>\r\n\r\n<head>\r\n<title>Rule 67:46:13:04 Continuing eligibility for TMB.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13:04\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13:04 Continuing eligibility for TMB.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 14 (filtered)\">\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\ttext-align:justify;\r\n\tfont-size:12.0pt;\r\n\tfont-family:\"Times New Roman\",\"serif\";}\r\n@page WordSection1\r\n\t{size:8.5in 11.0in;\r\n\tmargin:1.0in 1.0in 1.0in 1.0in;}\r\ndiv.WordSection1\r\n\t{page:WordSection1;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=WordSection1>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>67:46:13:04.&nbsp;&nbsp;Continuing eligibility\r\nfor TMB.</b> Eligibility for TMB continues for 12 consecutive months if the\r\nfamily continues to reside in the state and a dependent child who was a member\r\nof the family at the time the family was determined first eligible for TMB\r\ncontinues to live with the family.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Source:</b> 24 SDR 24, effective August 31,\r\n1997; 36 SDR 215, effective July 1, 2010; 41 SDR 7, effective July 29, 2014.</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>General Authority:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Law Implemented:</b> SDCL <A HREF=\"/statutes/DisplayStatute.aspx?Type=Statute&Statute=28-6-1\">28-6-1.</A></p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n<p class=MsoNormal>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Cross-Reference:</b> Definitions,\r\n&#167;&nbsp;67:46:12:01.</p>\r\n\r\n<p class=MsoNormal>&nbsp;</p>\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n</div><br /><hr><br /><div><html xmlns:v=\"urn:schemas-microsoft-com:vml\"\r\nxmlns:o=\"urn:schemas-microsoft-com:office:office\"\r\nxmlns:w=\"urn:schemas-microsoft-com:office:word\"\r\nxmlns=\"http://www.w3.org/TR/REC-html40\">\r\n\r\n<head>\r\n<title>Rule 67:46:13:05 Repealed.</title>\r\n<META NAME=\"Keywords\" Content=\"Administrative Rules 67:46:13:05\">\r\n<META NAME=\"Description\" Content=\"Administrative Rules 67:46:13:05 Repealed.\">\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=ProgId content=Word.Document>\r\n<meta name=Generator content=\"Microsoft Word 10\">\r\n<meta name=Originator content=\"Microsoft Word 10\">\r\n<link rel=File-List href=\"6746130000500d_files/filelist.xml\">\r\n<!--[if gte mso 9]><xml>\r\n <o:DocumentProperties>\r\n  <o:Author>lrpr14533</o:Author>\r\n  <o:LastAuthor>lrpr14296</o:LastAuthor>\r\n  <o:Revision>2</o:Revision>\r\n  <o:TotalTime>1</o:TotalTime>\r\n  <o:Created>2010-07-06T17:22:00Z</o:Created>\r\n  <o:LastSaved>2010-07-06T17:22:00Z</o:LastSaved>\r\n  <o:Pages>1</o:Pages>\r\n  <o:Words>24</o:Words>\r\n  <o:Characters>138</o:Characters>\r\n  <o:Company>State of South Dakota</o:Company>\r\n  <o:Lines>1</o:Lines>\r\n  <o:Paragraphs>1</o:Paragraphs>\r\n  <o:CharactersWithSpaces>161</o:CharactersWithSpaces>\r\n  <o:Version>10.6858</o:Version>\r\n </o:DocumentProperties>\r\n</xml><![endif]--><!--[if gte mso 9]><xml>\r\n <w:WordDocument>\r\n  <w:PunctuationKerning/>\r\n  <w:Compatibility>\r\n   <w:BreakWrappedTables/>\r\n   <w:SnapToGridInCell/>\r\n   <w:WrapTextWithPunct/>\r\n   <w:UseAsianBreakRules/>\r\n  </w:Compatibility>\r\n  <w:BrowserLevel>