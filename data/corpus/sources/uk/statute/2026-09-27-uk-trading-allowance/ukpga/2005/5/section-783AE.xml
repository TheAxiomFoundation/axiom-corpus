				</ukm:Metadata><Primary><Body DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/body" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/body" NumberOfProvisions="1289" RestrictExtent="E+W+S+N.I." RestrictStartDate="2026-07-15"><Part DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/part/6A" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/part/6A" NumberOfProvisions="37" id="part-6A" RestrictExtent="E+W+S+N.I." RestrictStartDate="2024-04-06"><Number><Strong><Addition ChangeId="key-a2" CommentaryRef="key-a2">PART 6A</Addition></Strong></Number><Title><Addition ChangeId="key-a2" CommentaryRef="key-a2">Income charged under this Act: trading and property allowances</Addition></Title><Chapter DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/part/6A/chapter/1" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/part/6A/chapter/1" NumberOfProvisions="19" id="part-6A-chapter-1" RestrictStartDate="2024-04-06"><Number><CommentaryRef Ref="key-a3"/><Addition ChangeId="key-a2" CommentaryRef="key-a2">CHAPTER 1</Addition></Number><Title><Addition ChangeId="key-a2" CommentaryRef="key-a2">Trading allowance</Addition></Title><Pblock DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/part/6A/chapter/1/crossheading/full-relief" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/part/6A/chapter/1/crossheading/full-relief" NumberOfProvisions="3" id="part-6A-chapter-1-crossheading-full-relief" RestrictStartDate="2024-04-06"><Title><Emphasis><Addition ChangeId="key-a2" CommentaryRef="key-a2">Full relief</Addition></Emphasis></Title><P1group RestrictStartDate="2024-04-06"><Title><Addition ChangeId="key-a2" CommentaryRef="key-a2">Full relief: introduction</Addition></Title><P1 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE" id="section-783AE"><Pnumber PuncAfter=""><Addition ChangeId="key-a2" CommentaryRef="key-a2">783AE</Addition></Pnumber><P1para><P2 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/1" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/1" id="section-783AE-1"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">1</Addition></Pnumber><P2para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">An individual qualifies for full relief for a tax year if—</Addition></Text><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/1/a" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/1/a" id="section-783AE-1-a"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">a</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the individual has relevant income for the tax year,</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/1/b" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/1/b" id="section-783AE-1-b"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">b</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the relevant income does not exceed the individual's trading allowance for the tax year, and</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/1/c" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/1/c" id="section-783AE-1-c"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">c</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">no election by the individual under section 783AL has effect for the tax year (election for full relief not to be given).</Addition></Text></P3para></P3></P2para></P2><P2 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2" id="section-783AE-2"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">2</Addition></Pnumber><P2para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">An individual also qualifies for full relief for a tax year if—</Addition></Text><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2/a" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2/a" id="section-783AE-2-a"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">a</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the individual has relevant income for the tax year which consists of or includes receipts of one or more relevant trades,</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2/b" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2/b" id="section-783AE-2-b"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">b</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the relevant income exceeds the individual's trading allowance for the tax year,</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2/c" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2/c" id="section-783AE-2-c"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">c</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the conditions mentioned in subsection (3) are met,</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2/d" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2/d" id="section-783AE-2-d"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">d</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">no election by the individual under section 783AL has effect for the tax year, and</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/2/e" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/2/e" id="section-783AE-2-e"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">e</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">no election by the individual under section 783AM has effect for the tax year (election for partial relief).</Addition></Text></P3para></P3></P2para></P2><P2 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/3" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/3" id="section-783AE-3"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">3</Addition></Pnumber><P2para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">The conditions are that—</Addition></Text><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/3/a" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/3/a" id="section-783AE-3-a"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2"><Substitution ChangeId="key-a4" CommentaryRef="key-a4">a</Substitution></Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2"><Substitution ChangeId="key-a4" CommentaryRef="key-a4">the cash basis applies for the tax year in relation to one or more of the trades mentioned in subsection (2)(a);</Substitution></Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/3/b" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/3/b" id="section-783AE-3-b"><Pnumber><Addition ChangeId="key-a2" CommentaryRef="key-a2">b</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">the individual's relevant income would not exceed the individual's trading allowance for the tax year if it were to be assumed that an election by the individual under section  </Addition><Addition ChangeId="key-a2" CommentaryRef="key-a2"><Substitution ChangeId="key-a5" CommentaryRef="key-a5">25C(1)</Substitution></Addition><Addition ChangeId="key-a2" CommentaryRef="key-a2">  had effect for the tax year, </Addition><Addition ChangeId="key-a2" CommentaryRef="key-a2"><Addition ChangeId="key-a6" CommentaryRef="key-a6">in relation to one or more of the trades mentioned in paragraph (a)</Addition></Addition> </Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/3/c" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/3/c" id="section-783AE-3-c"><Pnumber><CommentaryRef Ref="key-a7"/><Addition ChangeId="key-a2" CommentaryRef="key-a2">c</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .</Addition></Text></P3para></P3><P3 DocumentURI="http://www.legislation.gov.uk/ukpga/2005/5/section/783AE/3/d" IdURI="http://www.legislation.gov.uk/id/ukpga/2005/5/section/783AE/3/d" id="section-783AE-3-d"><Pnumber><CommentaryRef Ref="key-a8"/><Addition ChangeId="key-a2" CommentaryRef="key-a2">d</Addition></Pnumber><P3para><Text><Addition ChangeId="key-a2" CommentaryRef="key-a2">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .</Addition></Text></P3para></P3></P2para></P2></P1para></P1></P1group></Pblock></Chapter></Part></Body></Primary><Commentaries><Commentary id="key-a3" Type="C"><Para><Text><CitationSubRef SectionRef="part-6A-chapter-1" URI="http://www.legislation.gov.uk/id/ukpga/2005/5/part/6A/chapter/1" id="cy7gwqn73-00101">Pt. 6A Ch. 1</CitationSubRef> excluded (22.7.2020) by <Citation URI="http://www.legislation.gov.uk/id/ukpga/2020/14" Class="UnitedKingdomPublicGeneralAct" Year="2020" Number="14" Title="Finance Act 2020" id="cy7gwqn73-00102">Finance Act 2020 (c. 14)</Citation>, <CitationSubRef SectionRef="schedule-16-paragraph-4-4" URI="http://www.legislation.gov.uk/id/ukpga/2020/14/schedule/16/paragraph/4/4" CitationRef="cy7gwqn73-00102" Operative="true" id="cy7gwqn73-00103">Sch. 16 para. 4(4)</CitationSubRef></Text></Para></Commentary><Commentary id="key-a2" Type="F"><Para><Text>Pt. 6A inserted 