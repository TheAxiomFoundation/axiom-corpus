				</ukm:Metadata><Primary><Body DocumentURI="http://www.legislation.gov.uk/ukpga/2014/28/body" IdURI="http://www.legislation.gov.uk/id/ukpga/2014/28/body" NumberOfProvisions="78" RestrictStartDate="2018-02-14"><Pblock DocumentURI="http://www.legislation.gov.uk/ukpga/2014/28/crossheading/conditions-of-eligibility" IdURI="http://www.legislation.gov.uk/id/ukpga/2014/28/crossheading/conditions-of-eligibility" NumberOfProvisions="8" id="crossheading-conditions-of-eligibility" RestrictStartDate="2018-02-14"><Title><Emphasis>Conditions of eligibility</Emphasis></Title><P1group RestrictStartDate="2018-02-14"><Title>The person must be 16 or over</Title><P1 DocumentURI="http://www.legislation.gov.uk/ukpga/2014/28/section/6" IdURI="http://www.legislation.gov.uk/id/ukpga/2014/28/section/6" id="section-6"><Pnumber PuncAfter=""><CommentaryRef Ref="key-a1"/><CommentaryRef Ref="key-a2"/><CommentaryRef Ref="key-a3"/><CommentaryRef Ref="key-a4"/><CommentaryRef Ref="key-a5"/><CommentaryRef Ref="key-a6"/><CommentaryRef Ref="key-a7"/>6</Pnumber><P1para><Text>A person meets the condition of eligibility in this section if the person is at least 16 years old on the date of the declaration.</Text></P1para></P1></P1group></Pblock></Body></Primary><Commentaries><Commentary id="key-a1" Type="I"><Para><Text><CitationSubRef SectionRef="section-6" URI="http://www.legislation.gov.uk/id/ukpga/2014/28/section/6" id="cghnhvp52-00043">S. 6</CitationSubRef> in force at 14.11.2016 for the purposes of the trial  by <Citation URI="http://www.legislation.gov.uk/id/uksi/2016/1083" Class="UnitedKingdomStatutoryInstrument" Year="2016" Number="1083" Title="The Childcare Payments Act 2014 (Commencement No. 2) Regulations 2016" id="cghnhvp52-00044">S.I. 2016/1083</Citation>, <CitationSubRef SectionRef="regulation-2-b" URI="http://www.legislation.gov.uk/id/uksi/2016/1083/regulation/2/b" CitationRef="cghnhvp52-00044" Operative="true" id="cghnhvp52-00045">reg. 2(b)</CitationSubRef></Text></Para></Commentary><Comm