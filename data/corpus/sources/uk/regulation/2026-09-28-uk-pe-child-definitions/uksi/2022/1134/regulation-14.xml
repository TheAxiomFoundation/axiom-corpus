					<dc:identifier>http://www.legislation.gov.uk/uksi/2022/1134/regulation/14</dc:identifier><dc:title>The Childcare (Free of Charge for Working Parents) (England) Regulations 2022</dc:title><dc:language>en</dc:language><dc:subject scheme="SIheading">CHILDCARE, ENGLAND</dc:subject><dc:subject scheme="SIheading">LOCAL AUTHORITIES, ENGLAND</dc:subject><dc:publisher>Statute Law Database</dc:publisher><dc:modified>2026-03-19</dc:modified><dc:contributor>Expert Participation</dc:contributor><dct:valid>2026-01-01</dct:valid>
